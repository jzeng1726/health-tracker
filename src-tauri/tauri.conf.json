{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Health Tracker",
  "version": "../package.json",
  "identifier": "com.jeffreyzeng.healthtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Health Tracker", "width": 1280, "height": 860, "minWidth": 760, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Strength, endurance and bodyweight tracker",
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RUQ3MjA2QkVGMUQ3MzAKUldRdzEvRytCbkx0dVBqa2xvM1ZDcHozd0tKMlFxalRQV05QQndzSXl1QWZKbDFzWkdMVjV0RjYK",
      "endpoints": ["https://github.com/jzeng1726/health-tracker/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
